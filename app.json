{
  "expo": {
    "name": "Azimuth Quiz",
    "slug": "azimuth-quiz",
    "scheme": "azimuthquiz",
    "version": "2.18.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B1220",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Azimuth Quiz utilise ta position comme point de départ des distances, et l’orientation du téléphone pour que la boussole pointe vers le vrai nord."
      }
    },
    "android": {
      "package": "com.mathieujullien77190.azimuthquiz",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Azimuth Quiz utilise ta position comme point de départ des distances, et l’orientation du téléphone pour que la boussole pointe vers le vrai nord."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/azimuth-quiz"
    },
    "description": "Devine la direction et la distance d’un lieu du monde (villes, montagnes, monuments, sites naturels). Seul ou jusqu’à 6 joueurs sur le même téléphone.",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "69377410-31f8-4505-b089-ebd1008fdfee"
      }
    },
    "owner": "mathieujullien77190s-team"
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------------------------
    // Une seule collection `rooms` pour les deux jeux : Boussole (`game: 'compass'`) et Indices
    // (`'clues'`). Le champ `game` est fixé à la création et ne change
    // plus jamais (voir `gameUnchanged`) : c'est lui qui dit quelles règles de mise à jour s'appliquent.
    //
    // Pas d'écran de connexion : chaque appareil reçoit un uid via l'authentification anonyme de
    // Firebase (voir `ensureSignedIn` dans helpers/roomCode.ts). La room garde l'uid de son créateur
    // dans `hostUid` : c'est ce qui distingue l'hôte de tous les autres.
    // ---------------------------------------------------------------------------------------------

    // Vrai si l'appareil connecté est l'hôte de la room (évalué sur le document *avant* l'écriture).
    function isHost() {
      return request.auth != null && request.auth.uid == resource.data.hostUid;
    }

    // Le jeu d'une room ne change jamais, pas même par l'hôte.
    function gameUnchanged() {
      return request.resource.data.game == resource.data.game;
    }

    // Vrai si, dans la map `players`, seule l'entrée de l'appareil connecté est ajoutée, modifiée ou
    // supprimée : on peut se déclarer ou se renommer, jamais toucher à un autre joueur.
    function onlyOwnPlayerEntry() {
      return request.resource.data.get('players', {}).diff(resource.data.get('players', {})).affectedKeys()
        .hasOnly([request.auth.uid]);
    }

    // Réaction emoji (`reaction`, voir useRoomReactions) : n'importe quel joueur peut écraser ce champ unique, à son nom
    // (`uid` = le sien), avec un emoji court et un `seq` entier. Cosmétique : aucun historique, aucun autre champ.
    function reactionOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reaction'])
        || (request.resource.data.reaction.keys().hasOnly(['uid', 'emoji', 'seq'])
          && request.resource.data.reaction.uid == request.auth.uid
          && request.resource.data.reaction.emoji is string
          && request.resource.data.reaction.emoji.size() <= 8
          && request.resource.data.reaction.seq is int);
    }

    // Boussole : tout le monde répond en même temps. Un joueur qui n'est pas l'hôte ne peut toucher
    // qu'à sa propre entrée dans `players` (rejoindre, se renommer) et/ou dans `guesses` (envoyer sa
    // réponse de la manche) — jamais à celle d'un autre, ni à `settings`, `screen`, `origin`,
    // `places`, `scores` ou `totalScores`.
    function compassPlayer() {
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'guesses', 'reaction'])
        && reactionOk()
        && onlyOwnPlayerEntry()
        && request.resource.data.get('guesses', {}).diff(resource.data.get('guesses', {})).affectedKeys()
          .hasOnly([request.auth.uid]);
    }

    // Jeu à tour de rôle (Indices) : un plateau partagé, révélé tour par tour. Un joueur
    // qui n'est pas l'hôte peut :
    // - rejoindre ou se renommer (`joinRoomPresence`), même au salon où `turnUid` n'existe pas
    //   encore : il ne touche alors qu'à sa propre entrée de `players` ;
    // - s'il est le joueur dont c'est le tour (`turnUid`, lu dans le document *avant* l'écriture, donc
    //   c'est celui qui sortait qui autorise le passage de main, pas celui qui entre), modifier les
    //   champs de progression de la manche listés dans `turnFields` (voir helpers/room.ts de chaque
    //   jeu). `settings`, `screen` et `totalScores` restent réservés à l'hôte ;
    //   Une proposition par tour : `wrongGuessHints` (le nombre d'indices au moment de l'erreur) fait que le joueur ne peut
    //   plus proposer avant d'avoir dévoilé un indice (voir src/helpers/turnGuess.ts) ;
    // - envoyer une réaction emoji (`reaction`, voir `reactionOk`), seule ou avec ce qui précède.
    function turnBasedPlayer(turnFields) {
      return request.auth != null
        && reactionOk()
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'reaction'])
            && onlyOwnPlayerEntry())
          || (request.auth.uid == resource.data.get('turnUid', null)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(turnFields.concat(['reaction']))
            && onlyOwnPlayerEntry()));
    }

    // ---------------------------------------------------------------------------------------------
    // Données du jeu (lieux, pays, métiers) : lisibles par tout le monde (elles
    // sont de toute façon embarquées dans l'appli), modifiables uniquement par les administrateurs (la liste ci-dessous), qui
    // se connectent à l'outil `admin/` avec leur compte Google (adresse vérifiée). Les joueurs, eux,
    // n'ont qu'une authentification anonyme : ils ne passent jamais ce test.
    // ---------------------------------------------------------------------------------------------
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['mathieu.jullien77190@gmail.com', 'douchin.floran@gmail.com']
        && request.auth.token.email_verified == true;
    }

    match /places/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Les pays : nom, drapeau, devise, indicatif (recopiés dans chaque lieu, voir `denormalize.ts`). Les documents écrits au temps
    // de Silhouette portent d'autres champs (contour, voisins...) : ils restent, l'admin n'y touche pas.
    match /countries/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /personalityJobs/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Version des données (incrémentée à chaque écriture), pour un futur cache côté jeu.
    match /meta/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Journal des écritures de l'admin (une entrée par écriture : documents touchés + heure du serveur) : sert à
    // la synchronisation ciblée de l'admin, jamais lu ni écrit par le jeu.
    match /journal/{id} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------------------------------------
    // Journal d'erreurs du jeu (`helpers/reportError.ts`) : n'importe quel appareil connecte peut AJOUTER une erreur,
    // jamais la lire, la modifier ni la supprimer (seuls les admins lisent et nettoient). Pour ne pas pouvoir inonder la
    // collection, chaque erreur doit s'ecrire dans le MEME lot que deux compteurs du jour (`errorQuota`) qui montent de
    // exactement 1 : 30 erreurs par jour et par appareil, 1000 par jour au total. Rien de tout ca ne passe par le
    // journal de l'admin (`journal`) ni par `meta/dataVersion`. `expireAt` (30 jours) sert au nettoyage depuis la page
    // « Erreurs » de l'admin (une politique TTL automatique demanderait la facturation Firebase).
    // ---------------------------------------------------------------------------------------------

    // Le jour de la requete, en UTC et sans zero devant (c'est l'id des compteurs : voir `dayKey` dans errorSink.ts).
    function dayKey() {
      return string(request.time.year()) + '-' + string(request.time.month()) + '-' + string(request.time.day());
    }

    // Un compteur du jour : il vaut exactement 1 de plus qu'avant (1 a la creation) et reste sous son plafond.
    function quotaStep(limit) {
      return request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == (resource == null ? 1 : resource.data.count + 1)
        && request.resource.data.count <= limit;
    }

    // Vrai si le compteur `id` monte de 1 dans ce lot (etat apres l'ecriture = etat avant + 1).
    function quotaIncreased(id) {
      return getAfter(/databases/$(database)/documents/errorQuota/$(id)).data.count
        == (exists(/databases/$(database)/documents/errorQuota/$(id))
          ? get(/databases/$(database)/documents/errorQuota/$(id)).data.count : 0) + 1;
    }

    match /errorQuota/{id} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null
        && ((id == request.auth.uid + '_' + dayKey() && quotaStep(30))
          || (id == 'global_' + dayKey() && quotaStep(1000)));
    }

    match /errors/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['action', 'code', 'message', 'room', 'kind', 'repeats',
          'platform', 'version', 'uid', 'at', 'expireAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.action is string && request.resource.data.action.size() <= 80
        && request.resource.data.code is string && request.resource.data.code.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && (request.resource.data.room == null
          || (request.resource.data.room is string && request.resource.data.room.size() <= 40))
        && request.resource.data.kind in ['game', 'background']
        && request.resource.data.repeats is int && request.resource.data.repeats >= 0
        && request.resource.data.platform is string && request.resource.data.platform.size() <= 20
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.at == request.time
        && request.resource.data.expireAt is timestamp
        && quotaIncreased(request.auth.uid + '_' + dayKey())
        && quotaIncreased('global_' + dayKey());
    }

    // ---------------------------------------------------------------------------------------------
    // Avis de difficulté du mode dev (`helpers/devFeedback.ts`, `useDevFeedback`) : un appareil dont le réglage « dev »
    // contient le code secret est interrogé après chaque manche (« ce lieu était-il facile, moyen, difficile ? ») et écrit
    // un avis ici. La règle est la vraie barrière : un avis n'est accepté qu'avec le code dev (le même que `DEV_CODE` dans
    // src/data) dans le document. Un appareil connecté peut AJOUTER un avis, jamais le lire, le modifier ni le supprimer ;
    // seuls les admins le lisent (page « Avis difficulté » de l'admin, qui le met en texte pour une IA et le nettoie).
    // Rien de tout ça ne passe par le journal de l'admin (`journal`) ni par `meta/dataVersion`.
    // ---------------------------------------------------------------------------------------------
    match /devFeedback/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['devCode', 'game', 'targetType', 'targetKey', 'name', 'currentDifficulty',
          'suggestedDifficulty', 'at', 'uid'])
        && request.resource.data.keys().hasAll(['devCode', 'game', 'targetType', 'targetKey', 'name', 'currentDifficulty',
          'suggestedDifficulty', 'at', 'uid'])
        && request.resource.data.devCode == 'supermatou'
        && request.resource.data.game in ['compass', 'clues']
        && request.resource.data.targetType == 'place'
        && request.resource.data.targetKey is string && request.resource.data.targetKey.size() > 0
        && request.resource.data.targetKey.size() <= 80
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.currentDifficulty in ['easy', 'intermediate', 'hard']
        && request.resource.data.suggestedDifficulty in ['easy', 'intermediate', 'hard']
        && request.resource.data.at == request.time
        && request.resource.data.uid == request.auth.uid;
    }

    match /rooms/{code} {
      // N'importe qui peut lire une room (c'est ainsi qu'on vérifie un code avant de la rejoindre).
      allow read: if true;

      // Tout appareil connecté peut créer une room à son nom, pour l'un des deux jeux, mais jamais
      // écraser une room existante (en cas de collision de code, le client réessaie avec un autre).
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.game in ['compass', 'clues']
        && !exists(/databases/$(database)/documents/rooms/$(code));

      // L'hôte peut tout modifier (réglages, état de la manche, scores, retirer un joueur...), sauf le
      // jeu. Les autres joueurs ne peuvent faire que ce que permet le jeu de la room.
      allow update: if request.auth != null
        && gameUnchanged()
        && (isHost()
          || (resource.data.game == 'compass' && compassPlayer())
          || (resource.data.game == 'clues'
            && turnBasedPlayer(['players', 'revealedClueIds', 'turnUid', 'verdict', 'roundWinnerUid',
              'wrongGuessUid', 'wrongGuessSeq', 'wrongGuessHints', 'typing'])));

      // Seul l'hôte supprime sa room : à la fermeture de la partie, et avant d'en créer une nouvelle
      // (`deletePreviousRoomsByHost`, qui efface toutes ses anciennes rooms, quel que soit le jeu). Supprimer une room
      // qui n'existe deja plus (l'hote l'a fermee juste avant, le menage de l'ecran de preparation passe apres) ne fait
      // rien : c'est permis, plutot qu'un « permission denied » sans objet.
      allow delete: if request.auth != null && (resource == null || isHost());
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // No login screen — anonymous Firebase Auth instead (see `ensureSignedIn` in
    // helpers/room.ts): every device gets a uid transparently, and a room stores its creator's
    // uid as `hostUid` so only that device (not anyone who knows the code) can change its
    // settings. Anyone can still read a room to check a code, and create one, but never
    // overwrite an existing one (a code collision retries client-side instead).
    match /rooms/{code} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && !exists(/databases/$(database)/documents/rooms/$(code));
      // The host can change anything (settings, round/screen state via `startRoomGame`/
      // `finishRoomRound`/`nextRoomRound`, and remove any player — `removeRoomPlayer`). Anyone
      // else who's signed in can only touch *their own* entry, in `players` (join/rename —
      // `joinRoomPresence`) and/or in `guesses` (submitting a round answer — `submitRoomGuess`)
      // — never another uid's, and never `settings`/`screen`/`origin`/`places`/`scores`.
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.hostUid
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'guesses'])
            && request.resource.data.get('players', {}).diff(resource.data.get('players', {})).affectedKeys()
              .hasOnly([request.auth.uid])
            && request.resource.data.get('guesses', {}).diff(resource.data.get('guesses', {})).affectedKeys()
              .hasOnly([request.auth.uid])));
      // Lets `createRoom` clear out a host's previous rooms before making a new one
      // (`deletePreviousRoomsByHost`) — no one else can delete a room.
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostUid;
    }

    // Rules shared by every turn-based game's rooms (Clues, Silhouette): one shared board revealed
    // turn-by-turn instead of everyone answering independently. Same anonymous-auth/hostUid trust
    // model as `rooms`, adapted to "whoever's turn it is" instead of "each player only touches
    // their own guess":
    // - the host can change anything (settings, screen/round state, scores, remove any player);
    // - anyone signed in can join/rename themselves (`joinRoomPresence`) — even in the lobby, where
    //   `turnUid` doesn't exist yet — touching only their own `players` entry;
    // - only the player named by `turnUid` (evaluated against the document *before* this write, so a
    //   turn-passing write is authorized by the outgoing turn-holder, not the incoming one) can touch
    //   `progressKeys` (the game's own shared round-progress fields, see its `helpers/room.ts`) —
    //   never `settings`/`screen`/`totalScores`, which stay host-only.
    function ownPlayersEntryOnly() {
      return request.resource.data.get('players', {}).diff(resource.data.get('players', {})).affectedKeys()
        .hasOnly([request.auth.uid]);
    }

    function canUpdateTurnRoom(progressKeys) {
      return request.auth != null
        && (request.auth.uid == resource.data.hostUid
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
            && ownPlayersEntryOnly())
          || (request.auth.uid == resource.data.get('turnUid', null)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(progressKeys)
            && ownPlayersEntryOnly()));
    }

    // Clues' own online rooms — separate collection from `rooms` (Compass), see above.
    match /clueRooms/{code} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && !exists(/databases/$(database)/documents/clueRooms/$(code));
      allow update: if canUpdateTurnRoom(
        ['players', 'revealedClueIds', 'turnUid', 'verdict', 'roundWinnerUid', 'wrongGuessUid', 'wrongGuessSeq']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostUid;
    }

    // Silhouette's own online rooms, same turn model as Clues': the turn-holder reveals the next hint
    // tier (`hintsRevealed`, which passes `turnUid`) or reports a find/miss/give-up.
    match /contourRooms/{code} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && !exists(/databases/$(database)/documents/contourRooms/$(code));
      allow update: if canUpdateTurnRoom(
        ['players', 'hintsRevealed', 'turnUid', 'verdict', 'roundWinnerUid', 'wrongGuessUid', 'wrongGuessSeq']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostUid;
    }
  }
}
